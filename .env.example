# Copiá este archivo a .env y completá los valores.

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5433/luci?schema=public"

# Secreto para firmar la sesión del admin (generar: openssl rand -base64 48)
AUTH_SECRET=""

# Mercado Pago (dejar vacío para usar el modo demo en desarrollo)
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""

# URL pública del sitio (necesaria para back_urls y webhook de Mercado Pago)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
